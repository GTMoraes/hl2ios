+// (Échap) ; à la fermeture, disposition refaite et partie reprise.
+- (void)openEditor {
+    [self tapKey:SDL_SCANCODE_ESCAPE];
+    __weak P2TouchControls *weakSelf = self;
+    hl2ios_toque_editor_abrir(^(int salvou) {
+        P2TouchControls *s = weakSelf;
