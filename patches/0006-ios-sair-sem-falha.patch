@@ -228,8 +231,16 @@
         _exit((int)(rt_arg32(c, 0) & 0xff));
     } else if (!strcmp(name, "exit")) {
         int status = (int)rt_arg32(c, 0);
+#if TARGET_OS_IPHONE
+        // hl2ios (runtime/ios/hl2ios_sair.m) : l'app passe en arrière-plan avec l'animation du
