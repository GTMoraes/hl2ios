# Versões fixadas do app. Para atualizar, troque aqui (veja o LEIA-ME, seção "Atualizar").
# Uma linha por valor, sem comentário na mesma linha: o workflow lê este arquivo como está.

APP_NOME=HalfLife2
APP_EXECUTAVEL=hl2
APP_BUNDLE=com.gtm.halflife2
APP_VERSAO=0.4.1
IOS_MINIMO=17.0

# source-recomp (tradutor e runtime), 09/11/2026
RECOMP_REPO=https://github.com/kanapitsas/source-recomp.git
RECOMP_COMMIT=adb7546a46bb42a9f63a6c0c3cbf324d65c5bf2c

# mtld3d, ramo feat/native-host (Direct3D 9 sobre Metal): o mesmo commit que o setup.sh do source-recomp fixa
MTLD3D_REPO=https://github.com/kanapitsas/mtld3d.git
MTLD3D_COMMIT=101f37d3d45c760e95e20176f758b9d309c23885

# Binários Linux do Half-Life 2 (depot 224 da Steam): ficam num repositório privado, numa Release
DEPOT_REPO=GTMoraes/hl2ios-depot
DEPOT_TAG=depot-224
DEPOT_ARQUIVO=depot_224.zip
DEPOT_SHA256=527bc74b533a2704231f89a277ca5e907b3abc101061a7943da4758fa70ec623
